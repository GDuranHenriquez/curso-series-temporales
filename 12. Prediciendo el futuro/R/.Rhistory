get_btc_data <- function(start_date = "2017-01-01") {
start_ts <- as.numeric(as.POSIXct(start_date, tz = "UTC"))
now_ts <- as.numeric(Sys.time())
all_data <- list()
to_ts <- now_ts
#/index/cc/v1/historical/minutes?market=cadli&instrument=BTC-USD&
#limit=30&aggregate=1&fill=true&apply_mapping=true&response_format=JSON
repeat {
url <- paste0("https://data-api.coindesk.com/index/cc/v1/historical/minutes?",
"market=cadli&instrument=BTC-USD",
"&limit=2000",
"&to_ts=", to_ts,
"&aggregate=1&fill=true&apply_mapping=true&response_format=JSON")
response <- GET(url)
data <- fromJSON(content(response, "text"))$Data
if (is.null(data) || length(data) == 0) break
all_data[[length(all_data) + 1]] <- data
earliest_ts <- min(data$timestamp)
if (earliest_ts <= start_ts) break
# Restar un día para evitar duplicado
to_ts <- earliest_ts - 86400
}
# Combinar y filtrar
combined_data <- bind_rows(all_data)
combined_data <- combined_data %>%
filter(timestamp >= start_ts) %>%
mutate(date = as_datetime(timestamp)) %>%
arrange(date)
return(combined_data)
}
